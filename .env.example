# Copy to .env (not committed) to enable email notifications.
RING_SMTP_HOST=smtp.example.com
RING_SMTP_PORT=587
RING_SMTP_USER=user@example.com
RING_SMTP_PASSWORD=change-me
# Sender address; defaults to RING_SMTP_USER when empty
RING_SMTP_FROM=
# starttls (port 587), ssl (port 465) or none
RING_SMTP_SECURITY=starttls
